<UserControl
    x:Class="Nolvus.Dashboard.Frames.Installer.v5.PerformanceFrame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="32" Background="#2E2E2E">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">

            <!-- HEADER -->
            <TextBlock Text="Graphics and Performance Options"
                       Foreground="White"
                       FontSize="20"/>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,350"
                  ColumnSpacing="24">

                <!-- LEFT SIDE -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <!-- RESOLUTION -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#363636"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">

                            <StackPanel Spacing="10">
                                <TextBlock Text="Resolution" Foreground="#FFA500" FontSize="16" FontWeight="Bold"/>

                                <Grid ColumnDefinitions="115,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                                    <TextBlock x:Name="LblScreenRatio"
                                               Grid.Row="0"
                                               Text="Screen ratio"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstRatios"
                                              Grid.Row="0" Grid.Column="1"
                                              SelectionChanged="OnListRatiosChanged"
                                              DisplayMemberBinding="{Binding Value}"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock x:Name="LblResolution"
                                               Grid.Row="1"
                                               Text="Resolution"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstResolution"
                                              Grid.Row="1" Grid.Column="1"
                                              SelectionChanged="OnResolutionChanged"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="The resolution must match your screen resolution. If you want to play at lower resolution, use the downscaling feature below."
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="LblDownscaleResolution"
                                               Grid.Row="3"
                                               Text="Downscaled resolution"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TglBtnDownScale"
                                                  Grid.Row="3" Grid.Column="1"/>

                                    <ComboBox x:Name="DrpDwnLstScreenRes"
                                              Grid.Row="4" Grid.Column="1"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               Text="Not compatible with DLAA"
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GRAPHICS -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="#363636"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">

                            <StackPanel Spacing="10">
                                <TextBlock Text="Graphics" Foreground="#FFA500" FontSize="16" FontWeight="Bold"/>

                                <Grid ColumnDefinitions="115,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">

                                    <TextBlock Grid.Row="0"
                                               Text="Anti-Aliasing"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstAntiAliasing"
                                              Grid.Row="0" Grid.Column="1"
                                              SelectionChanged="OnAntiAliasingChanged"
                                              DisplayMemberBinding="{Binding Value}"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="DLAA only for Nvidia RTX card"
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Skyrim Ini profile"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstIni"
                                              Grid.Row="2" Grid.Column="1"
                                              SelectionChanged="OnIniChanged"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock x:Name="LblLods"
                                               Grid.Row="3"
                                               Text="LODs"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstLODs"
                                              Grid.Row="3" Grid.Column="1"
                                              SelectionChanged="OnLodsChanged"
                                              DisplayMemberBinding="{Binding Value}"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PERFORMANCE -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Grid.RowSpan="2"
                                Background="#363636"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">

                            <StackPanel Spacing="10">
                                <TextBlock Text="Performance" Foreground="#FFA500" FontSize="16" FontWeight="Bold"/>

                                <Grid ColumnDefinitions="115,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                                    <TextBlock Grid.Row="0"
                                               Text="Variant"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DrpDwnLstVariant"
                                              Grid.Row="0" Grid.Column="1"
                                              SelectionChanged="OnVariantChanged"
                                              DisplayMemberBinding="{Binding FullName}"
                                              MinWidth="180"
                                              Background="#2E2E2E"
                                              Foreground="White"/>

                                    <TextBlock x:Name="LblPhysics"
                                               Grid.Row="1"
                                               Text="Advanced Physics"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TglBtnPhysics"
                                                  Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="Physics on hair and armors (can be taxing on cities)"
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="LblRaytracing"
                                               Grid.Row="3"
                                               Text="Global Illumination"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TglBtnRayTracing"
                                                  Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="Global Illumination (fake ray tracing) will cost about 5-10 fps"
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="LblFpsStabilizer"
                                               Grid.Row="5"
                                               Text="FPS Stabilizer"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="TglBtnFPSStabilizer"
                                                  Grid.Row="5" Grid.Column="1"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               Text="Auto-reduces draw distance to maintain smooth FPS."
                                               Foreground="#FFA500"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- HARDWARE REQUIREMENT -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2"
                                Background="#363636"
                                BorderBrush="#444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">

                            <StackPanel Spacing="10">
                                <TextBlock Text="Hardware Requirement" Foreground="#FFA500" FontSize="16" FontWeight="Bold"/>

                                <Grid ColumnDefinitions="75,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Grid.Row="0" Text="GPU" Foreground="White"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblReqGpu" Foreground="#FFA500" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1" Text="VRAM" Foreground="White"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LblReqVram" Foreground="#FFA500" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2" Text="Storage" Foreground="White"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LblReqStorageTotal" Foreground="#FFA500" TextWrapping="Wrap"/>
                                </Grid>

                                <TextBlock x:Name="LblReqDisclaimer"
                                           Text="These recommendations are an estimation only. It will always vary depending on your computer. You can always tweak a bit more by selecting a lower Skyrim ini profile or disable other effects like Advanced Physics or Fake Ray tracing."
                                           Foreground="White"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>

                <!-- RIGHT PANEL -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Border Background="#363636"
                            BorderBrush="#444"
                            CornerRadius="4"
                            Padding="16">

                        <Grid RowDefinitions="*,Auto">

                            <!-- INFO TEXT -->
                            <StackPanel Grid.Row="0" Spacing="12">

                                <TextBlock Text="Info"
                                           Foreground="#FFA500"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="This new Nolvus version has some performance options"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="The Ultra variant is the graphically maxed out version of the list, the Redux is the same version gameplay wise but less heavy on vegetation and cities overhaul"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="DLAA anti aliasing is only available for Nvidia RTX cards. The option will be greyed out and set to TAA if you don't have an Nvidia RTX card."
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Advanced physics provides physics on hair and armors. This configuration is recommended for high end computers."
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Select your ini profile (based on Bethini recommended settings)"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="If you selected the Ultra variant and want to spare some fps and vram consumption, you can also choose the LODs (Terrain, objects and trees in the distance) quality option"
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="FPS Stabilizer is used to reduce draw distance on the fly to keep most fps possible. WARNING using this feature, you may gain 5-10 fps but some actors could pop really close to you. You may also experience objects and trees popins. Use this feature wisely."
                                           Foreground="#CCCCCC"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="LblHardwareWarning"
                                           Text="Current hardware configuration:"
                                           Foreground="White"
                                           Margin="0,16,0,4"/>

                                <!-- HARDWARE INFO -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="GPU:" Foreground="White"/>
                                    <TextBlock x:Name="LblGPU" Foreground="#FFA500"/>
                                    <TextBlock Text="CPU:" Foreground="White"/>
                                    <TextBlock x:Name="LblCPU" Foreground="#FFA500"/>
                                    <TextBlock Text="RAM:" Foreground="White"/>
                                    <TextBlock x:Name="LblRAM" Foreground="#FFA500"/>
                                </StackPanel>

                                <TextBlock Text="The displayed GPU is your integrated GPU and you can't select DLAA?"
                                           Foreground="White"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Click"
                                               Foreground="White"/>
                                    <TextBlock x:Name="LnkLblInfo"
                                               Text="here"
                                               Foreground="#FFA500"
                                               Classes="link"
                                               Cursor="Hand"
                                               PointerPressed="LnkLblInfo_PointerPressed"/>
                                </StackPanel>

                                <TextBlock Text="The mentioned requirements are an estimation only, all computers configurations are always different from one user to another."
                                           Foreground="#FFA500"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- BUTTONS -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8"
                                        Margin="0,24,0,0">

                                <Button x:Name="BtnPrevious"
                                        Content="Previous"
                                        MinWidth="90"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#2E2E2E"
                                        BorderBrush="Gray"
                                        Foreground="White"/>

                                <Button x:Name="BtnContinue"
                                        Content="Continue"
                                        MinWidth="90"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#2E2E2E"
                                        BorderBrush="Gray"
                                        Foreground="#FFA500"/>

                            </StackPanel>

                        </Grid>

                    </Border>
                </ScrollViewer>

            </Grid>

        </Grid>
    </Border>

</UserControl>
