<UserControl
    x:Class="Nolvus.Dashboard.Frames.Settings.GlobalSettingsFrame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2E2E2E" Padding="32">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">

            <!-- HEADER -->
            <TextBlock x:Name="LblStepText"
                       Text="Global Settings"
                       Foreground="White"
                       FontSize="20"/>

            <!-- CONTENT AREA -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="520,24,235,24,235,*">

                <!-- MEGA SETTINGS PANEL -->
                <Border x:Name="GrpBxMega"
                        Grid.Column="0"
                        Background="#363636"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Width="520"
                        Height="520"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                    <!-- WRAPPER GRID FOR CONTENT + SAVE BUTTON -->
                    <Grid RowDefinitions="*,Auto">

                        <!-- MAIN CONTENT -->
                        <Grid Grid.Row="0"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="10">

                            <!-- "Click here..." line -->
                            <StackPanel Grid.Row="0" Spacing="10">
                            <TextBlock Text="Mega Account"
                                       Foreground="#FFA500"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Click" Foreground="#CCCCCC"/>

                                <TextBlock Text="here"
                                           Foreground="#FFA500"
                                           Classes="link"
                                           Cursor="Hand"
                                           PointerPressed="OpenMega"/>

                                <TextBlock Text="to create your free mega.nz account."
                                           Foreground="#CCCCCC"/>
                            </StackPanel>
                            </StackPanel>

                            <!-- Anonymous toggle -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Anonymous Connection"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>

                                <ToggleSwitch x:Name="TglBtnAnonymous"
                                              PropertyChanged="TglBtnAnonymous_PropertyChanged"
                                              VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Info text -->
                            <TextBlock x:Name="LblMegaMessage"
                                       Grid.Row="2"
                                       Text="When created, please enter the email address and password you used to create your mega account."
                                       Foreground="#CCCCCC"
                                       TextWrapping="Wrap"/>

                            <!-- Email -->
                            <StackPanel Grid.Row="3" Spacing="4">
                                <TextBlock x:Name="LblEmail"
                                           Text="Email"
                                           Foreground="#CCCCCC"/>
                                <TextBox x:Name="TxtBxUserName"
                                         Background="#2E2E2E"
                                         Foreground="White"
                                         BorderBrush="#555"/>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Grid.Row="4" Spacing="4">
                                <TextBlock x:Name="LblPassword"
                                           Text="Password"
                                           Foreground="#CCCCCC"/>
                                <TextBox x:Name="TxtBxPassword"
                                         Background="#2E2E2E"
                                         Foreground="White"
                                         BorderBrush="#555"
                                         PasswordChar="*"/>
                            </StackPanel>

                            <!-- WARNING PANEL -->
                            <Border x:Name="PnlMessage"
                                    Grid.Row="5"
                                    Background="#14cb14"
                                    CornerRadius="4"
                                    Padding="8">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Image x:Name="PicBox"
                                           Grid.Column="0"
                                           Source="avares://NolvusDashboard/Assets/Info.png"
                                           Width="24"
                                           Height="24"/>

                                    <TextBlock x:Name="LblMessage"
                                               Grid.Column="1"
                                               Text="Your credentials will be stored and encrypted in your local Dashboard config file. Note that if you have a mega premium account, you will be able to download mega files faster."
                                               Foreground="White"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- EMPTY ROW -->
                            <Grid Grid.Row="6"/>

                        </Grid>

                        <!-- SAVE BUTTON ANCHORED BOTTOM RIGHT -->
                        <Button x:Name="BtnSaveMegaInfo"
                                Grid.Row="1"
                                Content="Save"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinWidth="120"
                                BorderBrush="Gray"
                                Foreground="White"/>
                    </Grid>
                </Border>

                <!-- PROCESS PANEL -->
                <Border x:Name="GrpBxProcess"
                        Grid.Column="2"
                        Background="#363636"
                        BorderBrush="#444"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Width="235"
                        Height="520"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                    <StackPanel Spacing="12">
                        <TextBlock Text="Process"
                                   Foreground="#FFA500"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="LblProcessCount"
                                   Text="Number of simultaneous mods installation"
                                   Foreground="#CCCCCC"
                                   TextWrapping="Wrap"/>

                        <ComboBox x:Name="DrpDwnLstProcessCount"
                                  Width="189"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnProcessorCountChanged"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Spacing="24">

                <!-- BROWSER SETTINGS PANEL -->
                <Border x:Name="GrpBxBrowser"
                    Background="#363636"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Width="235"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                    <StackPanel Spacing="12">
                        <TextBlock Text="Browser"
                                   Foreground="#FFA500"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Auto Click Slow Download"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Width="115"/>
                            <ToggleSwitch x:Name="TglBtnAutoClick"
                                            IsCheckedChanged="TglBtnAutoClick_Changed"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                    </StackPanel>

                </Border>

                <!-- ACTIONS PANEL -->
                <Border x:Name="GrpBxActions"
                    Background="#363636"
                    BorderBrush="#444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Width="235"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                    <StackPanel Spacing="12">
                        <TextBlock Text="Actions"
                                   Foreground="#FFA500"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <TextBlock Grid.Row="0"
                                       Text="Logs"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnCLearLogs"
                                    Grid.Row="0" Grid.Column="1"
                                    Content="Clear"
                                    MinWidth="90"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#2E2E2E"
                                    BorderBrush="Gray"
                                    Foreground="White"/>

                            <TextBlock Grid.Row="1"
                                       Text="Cache"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearCache"
                                    Grid.Row="1" Grid.Column="1"
                                    Content="Clear"
                                    MinWidth="90"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#2E2E2E"
                                    BorderBrush="Gray"
                                    Foreground="White"/>
                        </Grid>
                    </StackPanel>

                </Border>

                </StackPanel>

            </Grid>

            <!-- BACK BUTTON -->
            <Button x:Name="BtnBack"
                    Grid.Row="2"
                    Content="Back"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinWidth="120"
                    Background="#363636"
                    BorderBrush="Gray"
                    Foreground="White"/>

        </Grid>
    </Border>

</UserControl>