<UserControl
    x:Class="Nolvus.Dashboard.Controls.InstancePanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Nolvus.Components.Controls;assembly=Nolvus.Components"
    Width="884" Height="206">

    <Border Background="#363636" BorderBrush="Black" BorderThickness="1">

        <!-- Absolute layout to match WinForms coordinates EXACTLY -->
        <Canvas>

            <!-- Accent stripe -->
            <Rectangle Canvas.Left="0"
                       Canvas.Top="0"
                       Width="6"
                       Height="205"
                       Fill="Orange"/>

            <!-- Instance image -->
            <Border
                Canvas.Left="16"
                Canvas.Top="12"
                Width="273"
                Height="180"
                ZIndex="999">

                <Image
                    x:Name="PicInstanceImage"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
            </Border>

            <!-- Loading label overlay -->
            <Border Canvas.Left="16"
                    Canvas.Top="12"
                    Width="273"
                    Height="180"
                    Background="#363636">
                <TextBlock x:Name="LblImageLoading"
                           Text="Loading..."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
            </Border>


            <!-- Instance name -->
            <TextBlock x:Name="LblInstanceName"
                       Canvas.Left="292"
                       Canvas.Top="12"
                       Width="572"
                       Height="32"
                       Text="Nolvus Regular"
                       Foreground="White"
                       FontSize="15"
                       />

            <!-- Description -->
            <TextBlock x:Name="LblDesc"
                       Canvas.Left="295"
                       Canvas.Top="42"
                       Width="574"
                       Height="56"
                       Text="[Description]"
                       FontSize="11"
                       LineHeight="15"
                       MaxLines="3"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White"/>

            <!-- Version -->
            <TextBlock x:Name="LblVersion"
                       Canvas.Left="295"
                       Canvas.Top="96"
                       Text="5.0.2"
                       Foreground="White"/>

            <!-- Status -->
            <TextBlock x:Name="LblStatus"
                       Canvas.Left="295"
                       Canvas.Top="115"
                       Width="574"
                       Height="19"
                       Text="Loading status..."
                       Foreground="White"/>


            <!-- Update button -->
            <Button x:Name="BtnUpdate"
                                 Canvas.Left="581"
                                 Canvas.Top="157"
                                 Width="92"
                                 Height="35"
                                 Content="Update"
                                 Background="Black"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="Gray"
                                 Foreground="White"
                                 IsVisible="False"/>

            <!-- Manage button -->
            <Button x:Name="BtnView"
                                 Canvas.Left="679"
                                 Canvas.Top="157"
                                 Width="92"
                                 Height="35"
                                 Content="Manage"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="#363636"
                                 BorderBrush="Gray"
                                 Foreground="White"/>

            <!-- Play button -->
            <Button x:Name="BtnPlay"
                                 Canvas.Left="777"
                                 Canvas.Top="157"
                                 Width="92"
                                 Height="35"
                                 Content="Play"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Background="#363636"
                                 BorderBrush="Gray"
                                 Foreground="White"/>

        </Canvas>

    </Border>

</UserControl>
