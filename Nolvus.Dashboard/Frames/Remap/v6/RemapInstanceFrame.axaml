<UserControl
    x:Class="Nolvus.Dashboard.Frames.Remap.v6.RemapInstanceFrame"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#363636">

        <Grid RowDefinitions="Auto,*"
              Margin="3,0,3,0">

            <!-- LblStepText (top bar) -->
            <Border Grid.Row="0"
                    Background="#363636"
                    Height="24">
                <TextBlock x:Name="LblStepText"
                           Text="Remap Instance Paths"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Left"
                           Margin="0"
                           Padding="0"/>
            </Border>

            <!-- panel3 -->
            <Border x:Name="panel3"
                    Grid.Row="1"
                    Margin="3,5,3,6"
                    Background="#363636"
                    BorderBrush="#808080"
                    BorderThickness="1">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                      ColumnDefinitions="*"
                      Margin="10">

                    <!-- label3 -->
                    <TextBlock x:Name="label3"
                               Grid.Row="0"
                               Text="This feature allows you to move your instance into an other drive or directory (on the same drive). Usefull if you want to shorten your install path or move your instance elsewhere."
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <!-- label4 -->
                    <TextBlock x:Name="label4"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               Text="Select a new directory to move your instance (must be empty) and click on the Remap button."
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <!-- groupBox1 -->
                    <GroupBox x:Name="groupBox1"
                              Grid.Row="2"
                              Margin="0,12,0,0"
                              Header="Instance Info"
                              Foreground="White">

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="Auto,* ,Auto"
                              Margin="10"
                              ColumnSpacing="10"
                              RowSpacing="10">

                            <!-- LblInstance -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Background="#363636"
                                    Height="24">
                                <TextBlock x:Name="LblInstance"
                                           Text="Instance Paths"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextAlignment="Left"/>
                            </Border>

                            <!-- label1 + LblCurrentInstallPath -->
                            <TextBlock x:Name="label1"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Current Installation Path"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="LblCurrentInstallPath"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="[Path]"
                                       Foreground="Orange"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <!-- label2 -->
                            <TextBlock x:Name="label2"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Text="New installation path (select an empty directory)"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <!-- TxtBxInstancePath + BtnBrowseInstancePath -->
                            <TextBox x:Name="TxtBxInstancePath"
                                     Grid.Row="3"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     IsReadOnly="True"
                                     Background="#363636"
                                     Foreground="White"
                                     BorderBrush="#808080"
                                     BorderThickness="1"
                                     Height="20"
                                     VerticalContentAlignment="Center"/>

                            <Button x:Name="BtnBrowseInstancePath"
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Content="..."
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#363636"
                                    Foreground="White"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    Click="BtnBrowseInstancePath_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- PnlMessage -->
                    <Border x:Name="PnlMessage"
                            Grid.Row="3"
                            Margin="0,12,0,0"
                            Background="Orange"
                            BorderBrush="#808080"
                            BorderThickness="1"
                            Height="75">

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="*"
                              Margin="6">

                            <!-- PicBox -->
                            <Image x:Name="PicBox"
                                   Width="32"
                                   Height="32"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                            <!-- LblMessage -->
                            <TextBlock x:Name="LblMessage"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       Text="DO NOT CLOSE YOUR DASHBOARD DURING THIS OPERATION, YOU WILL BREAK YOUR INSTANCE!!!"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Bottom buttons (BtnCancel / BtnRemap) -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Spacing="10"
                                Margin="0,12,0,0">

                        <Button x:Name="BtnCancel"
                                Content="Back"
                                Width="88"
                                Height="40"
                                Background="#363636"
                                Foreground="White"
                                BorderBrush="White"
                                BorderThickness="1"
                                Click="BtnCancel_Click"/>

                        <Button x:Name="BtnRemap"
                                Content="Remap"
                                Width="88"
                                Height="40"
                                Background="#363636"
                                Foreground="White"
                                BorderBrush="White"
                                BorderThickness="1"
                                Click="BtnRemap_Click"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>